<?xml version="1.0" ?>
<robot name="teocart" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="grey" value="Gazebo/Grey" />
<xacro:property name="blue" value="Gazebo/Blue" />
<xacro:property name="black" value="Gazebo/Black" />
<xacro:property name="silver" value="Gazebo/DarkSilver" />
<xacro:property name="red" value="Gazebo/Red" />


<gazebo reference="base_link">
  <material>${silver}</material>

</gazebo>

<gazebo reference="Lidar_1">
  <material>${blue}</material>
  
</gazebo>

<gazebo reference="front_right_caster_wheel_1">
  <material>${grey}</material>
  
</gazebo>

<gazebo reference="front_left_caster_wheel_1">
  <material>${grey}</material>
  
</gazebo>

<gazebo reference="right_left_caster_wheel_1">
  <material>${grey}</material>
  
</gazebo>

<gazebo reference="rear_left_caster_wheel_1">
  <material>${grey}</material>
  
</gazebo>

<gazebo reference="camera_1">
  <material>${red}</material>
  
</gazebo>

<gazebo reference="left_wheel_1">
  <material>${black}</material>
  
</gazebo>

<gazebo reference="right_wheel_1">
  <material>${black}</material>
  
</gazebo>

</robot>
